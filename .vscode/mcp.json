{
  "servers": {
    "supabase-test": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ehppewofypspcfzboqvm&features=database,docs&read_only=true"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:github_mcp_pat}",
        "X-MCP-Toolsets": "issues,projects,labels,pull_requests,actions"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "github_mcp_pat",
      "description": "Fine-grained GitHub PAT scoped to gidiz/personal-growth only (Issues RW, Pull requests R, Actions R, Projects RW)",
      "password": true
    }
  ]
}
